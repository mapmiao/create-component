  },
  "keywords": [
    "react",
    "vue",
    "component",
    "cli",
    "generator",
    "scaffold"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "inquirer": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
